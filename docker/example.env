# Django settings
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change_me
DJANGO_ALLOWED_HOSTS=*
DJANGO_SETTINGS_MODULE=game_list.settings.base
DJANGO_DOCUMENTATION_ENABLED=True
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Database settings
DJANGO_DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=game_list
POSTGRES_USER=game_list
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# RabbitMQ now lives in the infrastructure repo's Shared Broker; this app connects to its own
# Private Vhost there. Credentials must match RABBITMQ_GAMELIST_BACKEND_PASSWORD in that repo's
# .env. amqp:// (plain, port 5672) works when both stacks share the sojusan-apps-shared-network
# Docker network, e.g. in local dev; a real cross-machine deployment uses amqps:// on port 5671.
CELERY_BROKER_URL=amqp://gamelist-backend:change_me@rabbitmq:5672/gamelist-backend

# Same Shared Broker, same gamelist-backend user, but vhost "/" (not the Private Vhost above) -
# this is where the infrastructure repo binds the pre-provisioned, read-only
# gamelist-backend.user-deletion queue that Keycloak's account-erasure events land on.
KEYCLOAK_EVENTS_BROKER_URL=amqp://gamelist-backend:change_me@rabbitmq:5672//
KEYCLOAK_USER_DELETION_QUEUE=gamelist-backend.user-deletion

# Redis settings
REDIS_URL=redis://redis:6379/1

# Gunicorn settings
GUNICORN_TIMEOUT=300
GUNICORN_RELOAD=False
GUNICORN_LOGLEVEL=info

# Sojusan Game settings
GL_LOG_DIR_PATH=/var/log/game_list/
GL_LOG_FILENAME=game_list.log

# IGDB import settings
IGDB_CLIENT_ID=change_me
IGDB_CLIENT_SECRET=change_me

# Grafana settings
GF_INSTALL_PLUGINS=grafana-clock-panel,grafana-simple-json-datasource

# Steam API settings
STEAM_API_KEY=change_me

# Keycloak settings
KEYCLOAK_SERVER_URL=change_me
KEYCLOAK_ISSUER_URL=change_me
KEYCLOAK_REALM=change_me
KEYCLOAK_AUDIENCE=change_me
KEYCLOAK_CLIENT_ID=change_me

# OpenTelemetry settings
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_EXPORTER_OTLP_INSECURE=True
OTEL_RESOURCE_ATTRIBUTES=service.name=game_list
