DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change_me
DJANGO_ALLOWED_HOSTS=*
DJANGO_SETTINGS_MODULE=my_game_list.settings.base
DJANGO_DOCUMENTATION_ENABLED=True
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

DJANGO_DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=my_game_list
POSTGRES_USER=my_game_list
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//

REDIS_URL=redis://redis:6379/1

GUNICORN_TIMEOUT=300
GUNICORN_RELOAD=False
GUNICORN_LOGLEVEL=info

MGL_LOG_DIR_PATH=/var/log/my_game_list/
MGL_LOG_FILENAME=my_game_list.log

GF_INSTALL_PLUGINS=grafana-clock-panel,grafana-simple-json-datasource
IGDB_CLIENT_ID=change_me
IGDB_CLIENT_SECRET=change_me

STEAM_API_KEY=change_me

KEYCLOAK_SERVER_URL=change_me
KEYCLOAK_ISSUER_URL=change_me
KEYCLOAK_REALM=change_me
KEYCLOAK_AUDIENCE=change_me
KEYCLOAK_CLIENT_ID=change_me

OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_EXPORTER_OTLP_INSECURE=True
OTEL_RESOURCE_ATTRIBUTES=service.name=my_game_list
